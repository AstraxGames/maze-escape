{
  "name": "maze-escape",
  "productName": "Maze Escape",
  "version": "1.2.0",
  "description": "3D Multiplayer Maze Escape game",
  "author": "AstraX Games",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "publish": "electron-builder -p always"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AstraxGames/maze-escape.git"
  },
  "build": {
    "appId": "com.astraxgames.mazeescape",
    "icon": "icon.ico",
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "AstraxGames",
        "repo": "maze-escape",
        "releaseType": "draft"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    }
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}